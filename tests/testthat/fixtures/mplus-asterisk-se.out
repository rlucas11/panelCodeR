INPUT INSTRUCTIONS

  TITLE:
  small
  DATA:
  FILE = "small.dat";
  VARIABLE:
  NAMES = x_1 x_2 x_3;
   MISSING=.;

  ANALYSIS:
  MODEL=NOCOVARIANCES;
  COVERAGE=.001;STARTS=5;

  MODEL:
    l_x_1 BY x_1@1 (p1);
    x_1@0 (p2);
    l_x_2 BY x_2@1 (p3);
    x_2@0 (p4);
    l_x_3 BY x_3@1 (p5);
    x_3@0 (p6);
    l_x_1@0 (p7);
    l_x_2@0 (p8);
    l_x_3@0 (p9);
    a_x_1 BY l_x_1@1 (p10);
    a_x_2 BY l_x_2@1 (p11);
    a_x_3 BY l_x_3@1 (p12);
    a_x_1@0 (p13);
    a_x_2@0 (p14);
    a_x_3@0 (p15);
    i_x_1 BY a_x_1@1 (p16);
    i_x_2 BY a_x_2@1 (p17);
    i_x_3 BY a_x_3@1 (p18);
    i_x_1* (xvar1);
    i_x_2* (xvar2);
    i_x_3* (xvar3);
    a_x_2 ON a_x_1* (a_1_2);
    a_x_3 ON a_x_2* (a_1_3);
    [x_1*] (p24);
    [x_2*] (p25);
    [x_3*] (p26);
    [l_x_1@0] (p27);
    [l_x_2@0] (p28);
    [l_x_3@0] (p29);
    [a_x_1@0] (p30);
    [a_x_2@0] (p31);
    [a_x_3@0] (p32);
    [i_x_1@0] (p33);
    [i_x_2@0] (p34);
    [i_x_3@0] (p35);
  MODEL CONSTRAINT:

     a_1_3 = a_1_2;
     xvar1 > 0;
     xvar2 > 0;
     xvar3 > 0;
  OUTPUT:
  stdyx; cinterval; TECH4;




